type AuditEntry = record {
  id : nat64;
  status : AuditStatus;
  timestamp_ns : nat64;
  // Outbound messages as `canister.method` (`canister.<candid interface>` for an
  // interface fetch), in order. On a `Started`/`Call` entry: the one message about to
  // be sent. On a final entry: all of them. `None` on entries from before this field.
  methods : opt vec text;
  // Links all entries of one run: the id of the run's `Started` entry, or the entry's
  // own id if the run never sent a message. Script hashes alone can't tell apart two
  // runs of the same script (one trapped, one not), and runs interleave across awaits.
  // `None` only on entries written before this field existed.
  run_id : opt nat64;
  calls : nat32;
  violations : vec text;
  instructions : nat64;
  error : opt text;
  language : text;
  canisters : vec text;
  // First 16 hex chars of the bearer token's SHA-256 (never the token itself).
  caller : text;
  script_sha256 : text;
};
type AuditStatus = variant {
  Ok;
  // Written before a script's first outbound message. A run whose entries are only
  // `Started`/`Call` (no final entry with its `run_id`) trapped after reaching the network.
  Started;
  Error;
  // Written before each later outbound message of the run. Like `Started`, it is
  // committed when the message is sent, so it survives a later trap.
  Call;
  PolicyViolation;
};
type HttpRequest = record {
  url : text;
  method : text;
  body : blob;
  headers : vec record { text; text };
  certificate_version : opt nat16;
};
type HttpResponse = record {
  body : blob;
  headers : vec record { text; text };
  upgrade : opt bool;
  status_code : nat16;
};
type HttpUpdateRequest = record {
  url : text;
  method : text;
  body : blob;
  headers : vec record { text; text };
};
type InitArgs = record {
  // SHA-256 hex digests of bearer tokens: `echo -n "$TOKEN" | shasum -a 256`.
  token_sha256 : vec text;
  allowlist : vec record { principal; vec text };
  limits : opt Limits;
};
type Limits = record {
  // `null` (default): calls wait for the reply however long it takes (guaranteed
  // response), so a target that never answers keeps this canister from stopping and
  // upgrading. A number: calls time out after that many seconds (the IC caps it at
  // 300); a timed-out call may or may not have executed on the target.
  call_timeout_seconds : opt nat32;
  max_calls_per_script : nat32;
  // Checked against `call_context_instruction_counter()` before every call and after the run.
  max_instructions : nat64;
  // `true`: every MCP request goes through an update call, so responses are certified
  // by consensus (about 1-2 s each) and the uncertified demo page is disabled.
  // `null`/`false` (default): initialize, tools/list and cached searches are answered
  // by fast query calls, which a single malicious node could alter.
  certified_reads : opt bool;
};
type PolicyView = record {
  // (token hash prefix, label)
  tokens : vec record { text; text };
  allowlist : vec record { principal; vec text };
  limits : Limits;
};
type Result = variant { Ok; Err : text };
service : (opt InitArgs) -> {
  add_api_token_hash : (text, text) -> (Result);
  get_audit_log_len : () -> (nat64) query;
  // Newest first; `limit` is capped at 100.
  get_audit_logs : (nat64, nat64) -> (vec AuditEntry) query;
  get_policy : () -> (PolicyView) query;
  http_request : (HttpRequest) -> (HttpResponse) query;
  http_request_update : (HttpUpdateRequest) -> (HttpResponse);
  remove_allowlist : (principal) -> (bool);
  revoke_api_token_hash : (text) -> (bool);
  set_allowlist : (principal, vec text) -> ();
  // Register (or clear, with `null`) a `.did` for a target that does not expose
  // `__get_candid_interface_tmp_hack`.
  set_candid_override : (principal, opt text) -> (Result);
  set_limits : (Limits) -> ();
}
