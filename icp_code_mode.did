type AuditEntry = record {
  id : nat64;
  status : AuditStatus;
  timestamp_ns : nat64;
  // Outbound messages as `canister.method`, in order. Interface fetches appear as
  // `aaaaa-aa.canister_metadata(<target>)` and `<target>.__get_candid_interface_tmp_hack`. On a `Started`/`Call` entry: the one message about to
  // be sent. On a final entry: all of them. `None` on entries from before this field.
  // Pages cut long lists (see `audit_page`); the `Started`/`Call` entries have each one.
  methods : opt vec text;
  // Links all entries of one run: the id of the run's `Started` entry, or the entry's
  // own id if the run never sent a message. Script hashes alone can't tell apart two
  // runs of the same script (one finished, one not), and runs interleave across awaits.
  // `None` only on entries written before this field existed.
  run_id : opt nat64;
  // On a `Started`/`Call` entry for a script's call: its Candid-encoded argument, as hex
  // (decode with `didc decode`), or past 1 KiB as `sha256:<hex> prefix:<first 512 bytes
  // as hex>`. `None` on interface fetches, final entries and entries from before this field.
  args : opt vec text;
  calls : nat32;
  // Policy refusals. They may quote script- or target-authored text, which is escaped
  // and quoted (as are labels in `methods`).
  violations : vec text;
  // Instructions the run used so far. On a `Trapped` entry, a lower bound (it leaves out
  // the trapped execution).
  instructions : nat64;
  // May hold script- or target-authored text (a script's own error, a target's reject).
  error : opt text;
  language : text;
  canisters : vec text;
  // First 16 hex chars of the bearer token's SHA-256 (never the token itself).
  caller : text;
  script_sha256 : text;
};
type AuditStatus = variant {
  Ok;
  // Written as a script's first outbound message is handed to the system. A run whose
  // entries are only `Started`/`Call` has no closing entry (yet). Normally that means it
  // is still waiting on a reply (`get_policy().pending_run_ids` lists those). A run
  // that trapped gets a `Trapped` entry. If neither applies, treat it as unknown.
  Started;
  Error;
  // Written for each later outbound message of the run. Like `Started`, it is
  // committed together with the message it describes, so it stays even if the run
  // never finishes.
  Call;
  // The canister trapped while handling a reply, after messages had gone out. Written
  // during cleanup, in place of the final entry that the trap rolled back. Its
  // `instructions` leaves out the trapped execution (rolled back with the trap), so it
  // is a lower bound.
  Trapped;
  PolicyViolation;
};
type HttpRequest = record {
  url : text;
  method : text;
  body : blob;
  headers : vec record { text; text };
  certificate_version : opt nat16;
};
type HttpResponse = record {
  body : blob;
  headers : vec record { text; text };
  upgrade : opt bool;
  status_code : nat16;
};
type HttpUpdateRequest = record {
  url : text;
  method : text;
  body : blob;
  headers : vec record { text; text };
};
type InitArgs = record {
  // SHA-256 hex digests of bearer tokens: `echo -n "$TOKEN" | shasum -a 256`.
  token_sha256 : vec text;
  allowlist : vec record { principal; vec text };
  limits : opt Limits;
};
type Limits = record {
  // Seconds a call waits for its reply (1-300, the IC's range; other values are stored
  // clamped). `null` (default): 300. A timed-out call may or may not have executed on
  // the target; the error says so.
  call_timeout_seconds : opt nat32;
  // Tool calls each bearer token may make per minute (on the update path). `null`
  // (default): 120. Over the limit, requests are refused before they run, so nothing is
  // spent and nothing is logged. This bounds how fast one token can spend cycles and
  // grow the audit log.
  tool_calls_per_minute : opt nat32;
  max_calls_per_script : nat32;
  // Checked against `call_context_instruction_counter()` before every call and after the run.
  // At most 30B (larger values are stored as 30B).
  max_instructions : nat64;
  // `true`: every MCP request goes through an update call, so responses are certified
  // by consensus (about 1-2 s each) and the uncertified demo page is disabled.
  // `null`/`false` (default): initialize, tools/list and cached searches are answered
  // by fast query calls, which a single malicious node could alter.
  certified_reads : opt bool;
};
type PolicyView = record {
  // Runs (by `run_id`) that have sent messages and not ended: still waiting on a reply.
  pending_run_ids : vec nat64;
  // (token hash prefix, label)
  tokens : vec record { text; text };
  // Audit entries that could not be written (stable memory full) since the last upgrade.
  lost_audit_entries : nat64;
  // Interfaces set with `set_candid_override` (canister, bytes, SHA-256). Each one is
  // used instead of fetching that canister's own interface.
  candid_overrides : vec record { text; nat64; text };
  allowlist : vec record { principal; vec text };
  // Scripts running right now (at most `MAX_CONCURRENT_RUNS`).
  active_runs : nat32;
  limits : Limits;
};
type Result = variant { Ok; Err : text };
service : (opt InitArgs) -> {
  add_api_token_hash : (text, text) -> (Result);
  get_audit_log_len : () -> (nat64) query;
  // Newest first; `limit` is capped at 100.
  get_audit_logs : (nat64, nat64) -> (vec AuditEntry) query;
  // Newest first, below id `before` (`null`: from the newest); `limit` is capped at 100.
  // Pass the last id of a page to get the next one: unlike offsets, ids do not shift as
  // entries are appended.
  get_audit_logs_before : (opt nat64, nat64) -> (vec AuditEntry) query;
  get_policy : () -> (PolicyView) query;
  http_request : (HttpRequest) -> (HttpResponse) query;
  http_request_update : (HttpUpdateRequest) -> (HttpResponse);
  remove_allowlist : (principal) -> (bool);
  // Takes the full hash or the 16-character id `get_policy` shows (any unique prefix of at
  // least 16 hex characters). `false`: no token, or the prefix matches more than one.
  revoke_api_token_hash : (text) -> (bool);
  // Refused (the call traps) for the management canister, this canister, or past the caps
  // on methods per canister, method name length and allowlist size. `"*"` allows every
  // method except delegating ones such as `icrc2_approve`, which must be listed by name.
  set_allowlist : (principal, vec text) -> ();
  // Register (or clear, with `null`) a `.did` for a target. While set it takes precedence:
  // the target's own interface is not fetched or refreshed. `remove_allowlist` does not
  // clear it.
  set_candid_override : (principal, opt text) -> (Result);
  // Replaces every field (an omitted `opt` field is `null`, which means its default) and
  // returns the previous limits.
  set_limits : (Limits) -> (Limits);
}
